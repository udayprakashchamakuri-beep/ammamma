GNANI_API_KEY=

# LLM: Gemini is used unless EVON_BASE_URL is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Self-hosted Evon (vLLM, OpenAI-compatible), e.g. on Nebius: http://<host>:8000/v1
EVON_BASE_URL=
EVON_API_KEY=none
EVON_MODEL=model

# Language Ammamma answers in; she can switch mid-call when the caller asks.
# hi-IN en-IN te-IN ta-IN kn-IN ml-IN mr-IN bn-IN gu-IN pa-IN (voices are in bot.py LANGUAGES)
AMMAMMA_LANG=hi-IN

# Only for -t twilio (lets the bot hang up the call)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
