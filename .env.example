GNANI_API_KEY=

# LLM: Gemini is used unless EVON_BASE_URL is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Self-hosted Evon (vLLM, OpenAI-compatible), e.g. on Nebius: http://<host>:8000/v1
EVON_BASE_URL=
EVON_API_KEY=none
EVON_MODEL=model

# Ammamma's language and Timbre v2.5 voice (voice should match the language).
# Hindi: Chitra, Yashvi   Telugu: Lavanya, Lehara   Tamil: Trisha, Noopur   Kannada: Saanvi
AMMAMMA_LANG=hi-IN
AMMAMMA_VOICE=Chitra

# Only for -t twilio (lets the bot hang up the call)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
